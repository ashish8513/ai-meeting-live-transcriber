# Copy to `.env` for docker compose:  copy .env.docker.example .env

POSTGRES_PASSWORD=meetscribe
JWT_SECRET=change-me-use-long-random-string-in-production
INTERNAL_API_KEY=dev-internal-key-change-me
ADMIN_EMAIL=admin@meetscribe.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-facing URLs (baked into frontend at build time)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8200
NEXT_PUBLIC_WS_URL=ws://localhost:8765
NEXT_PUBLIC_SIGNAL_URL=http://localhost:8081/offer

# Optional — profile "stack" (ASR + NLP)
OPENAI_API_KEY=
PYANNOTE_TOKEN=
HF_TOKEN=
WHISPER_MODEL=base.en
SUMMARY_INTERVAL=5
