# Copy to `.env` (gitignored)

# --- API keys ---
OPENAI_API_KEY=sk-your-openai-key-here
PYANNOTE_TOKEN=hf_your-huggingface-token-here
HF_TOKEN=hf_your-huggingface-token-here

# --- ASR / meeting ---
NLP_SERVICE_URL=http://localhost:8100
WHISPER_MODEL=base.en
USE_LOCAL_MIC=False
SUMMARY_INTERVAL=5
SUMMARY_WINDOW=5

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://meetscribe:meetscribe@localhost:5432/meetscribe

# --- JWT Auth API (port 8200) ---
JWT_SECRET=change-me-use-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_API_KEY=dev-internal-key-change-me
AUTH_API_URL=http://localhost:8200
ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
