# Copy this file to `.env` and fill in your keys (`.env` is gitignored).
# Get OpenAI key: https://platform.openai.com/api-keys
# Get Hugging Face token: https://huggingface.co/settings/tokens

OPENAI_API_KEY=sk-your-openai-key-here
PYANNOTE_TOKEN=hf_your-huggingface-token-here
HF_TOKEN=hf_your-huggingface-token-here

# Optional
NLP_LM_MODEL=gpt-4o-mini
NLP_SERVICE_URL=http://localhost:8100
WHISPER_MODEL=base.en
USE_LOCAL_MIC=False
